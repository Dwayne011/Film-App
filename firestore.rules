rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per shared wheel. There is no sign-in: the document's long random name is the key,
    // so it can be opened and changed only by someone who has the invite link. Nobody can list or delete wheels.
    match /rooms/{roomId} {
      allow get: if roomId.size() >= 20;
      allow create, update: if roomId.size() >= 20
        && request.resource.data.keys().hasOnly(['seen', 'current', 'skipSeen', 'tmdb', 'updatedAt'])
        && request.resource.data.seen is map
        && request.resource.data.seen.size() <= 100;
    }
  }
}
